# Resolve the source tree at configuration time for all C30D packages.
get_filename_component(_slicer_repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(_slicer_parent "${_slicer_repository}/.." ABSOLUTE)
get_filename_component(_slicer_parent_name "${_slicer_parent}" NAME)
set(_slicer_workspace "${_slicer_repository}")
if(_slicer_parent_name STREQUAL "src")
  get_filename_component(_slicer_workspace "${_slicer_parent}/.." ABSOLUTE)
endif()

if(NOT SLICER_HARDWARE_ROOT)
  if(NOT "$ENV{SLICER_HARDWARE_ROOT}" STREQUAL "")
    set(SLICER_HARDWARE_ROOT "$ENV{SLICER_HARDWARE_ROOT}")
  elseif(EXISTS "${_slicer_workspace}/deps/slicer_ugv_hardware")
    set(SLICER_HARDWARE_ROOT "${_slicer_workspace}/deps/slicer_ugv_hardware")
  else()
    set(SLICER_HARDWARE_ROOT "${_slicer_repository}/Hardware")
  endif()
endif()
get_filename_component(SLICER_HARDWARE_ROOT "${SLICER_HARDWARE_ROOT}" REALPATH)
if(NOT EXISTS "${SLICER_HARDWARE_ROOT}/config.yaml" OR NOT IS_DIRECTORY "${SLICER_HARDWARE_ROOT}/Host")
  message(FATAL_ERROR "Hardware config.yaml and Host/ required at ${SLICER_HARDWARE_ROOT}. Check the workspace dependency or SLICER_HARDWARE_ROOT.")
endif()

if(NOT SLICER_HARDWARE_CONFIG)
  if(NOT "$ENV{SLICER_HARDWARE_CONFIG}" STREQUAL "")
    set(SLICER_HARDWARE_CONFIG "$ENV{SLICER_HARDWARE_CONFIG}")
  else()
    set(SLICER_HARDWARE_CONFIG "${SLICER_HARDWARE_ROOT}/config.yaml")
  endif()
endif()
get_filename_component(SLICER_HARDWARE_CONFIG "${SLICER_HARDWARE_CONFIG}" REALPATH)
if(NOT EXISTS "${SLICER_HARDWARE_CONFIG}" OR IS_DIRECTORY "${SLICER_HARDWARE_CONFIG}")
  message(FATAL_ERROR "Hardware configuration file required at ${SLICER_HARDWARE_CONFIG}.")
endif()

unset(_slicer_repository)
unset(_slicer_parent)
unset(_slicer_parent_name)
unset(_slicer_workspace)
