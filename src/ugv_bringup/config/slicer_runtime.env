# 只设置新RTK工程运行环境；不启动节点。外部ROS变量优先。
UGV_RUNTIME_IMAGE=ugv-online-rtk:arm64-20261030
UGV_RUNTIME_MASTER_URI=http://127.0.0.1:11311
UGV_RUNTIME_IP=127.0.0.1
# 凭据只引用外部只读文件，不复制、不打印内容。
if [[ -r /home/potato/.config/slicer/ntrip.json ]];then
 UGV_NTRIP_CREDENTIALS="${UGV_NTRIP_CREDENTIALS:-/home/potato/.config/slicer/ntrip.json}"
fi
