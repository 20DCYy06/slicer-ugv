<launch>
  <!-- Adapter emits no TF; global RL alone owns dynamic map->odom. -->
  <arg name="site_config" default="$(find ugv_bringup)/config/gnss_site.yaml"/>
  <arg name="source_config" default="$(find ugv_bringup)/config/online_runtime/config/slicer_config.yaml"/>
  <arg name="session_file" default="$(optenv ROS_HOME /tmp)/geographic-session.json"/>
  <group ns="global_localization">
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf" output="screen">
      <rosparam command="load" file="$(find ugv_bringup)/config/global_ekf.yaml"/>
      <remap from="odometry/filtered" to="/global/odom"/>
    </node>
  </group>
  <node pkg="ugv_navigation" type="gnss_global.py" name="geographic" output="screen">
    <rosparam command="load" file="$(find ugv_bringup)/config/outdoor_localization.yaml"/>
    <param name="site_config" value="$(arg site_config)"/>
    <param name="source_config" value="$(arg source_config)"/>
    <param name="session_file" value="$(arg session_file)"/>
  </node>
</launch>
