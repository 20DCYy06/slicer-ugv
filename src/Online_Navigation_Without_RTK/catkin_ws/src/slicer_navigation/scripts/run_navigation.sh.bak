#!/usr/bin/env bash
# 宿主启动器：所有 ROS/地图/记录/巡航程序都在既有 Noetic 镜像中执行。
set -euo pipefail
PKG="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="$(cd "$PKG/../../.." && pwd)"
MODE="${1:-help}"; shift || true
BACKGROUND=false
if [[ "${1:-}" == --background ]]; then BACKGROUND=true; shift; fi
IMAGE="$(/usr/bin/python3 -s -c 'import sys,yaml;print(yaml.safe_load(open(sys.argv[1]))["runtime"]["docker_image"])' "$ROOT/config/slicer_config.yaml")"
docker image inspect "$IMAGE" >/dev/null
if [[ "$MODE" == stop ]]; then
  for name in slicer-navigation slicer-mapping slicer-waypoint-recorder slicer-patrol slicer-nav-rviz; do
    if docker ps --format '{{.Names}}' | grep -qx "$name"; then docker stop -t 5 "$name"; fi
  done
  exit 0
fi
NETWORK=host
[[ "$MODE" != check ]] || NETWORK=none
ARGS=(--rm --init --network "$NETWORK" --user "$(id -u):$(id -g)"
  -e HOME=/tmp/slicer-nav-home -e ROS_HOME=/tmp/slicer-nav-ros -e ROS_LOG_DIR=/tmp/slicer-nav-log
  -e ROS_MASTER_URI=http://192.168.10.33:11311 -e ROS_IP=192.168.10.33 -e PYTHONNOUSERSITE=1 -e PYTHONUNBUFFERED=1
  -e DISABLE_ROS1_EOL_WARNINGS=1
  -e OMP_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1 -v "$ROOT:/slicer" -w /slicer)
if [[ "$MODE" == build ]]; then
  exec docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$ROOT:/slicer" -w /slicer "$IMAGE" bash -c \
    'set -e; source /opt/ros/noetic/setup.bash; if [[ -f catkin_ws/devel/setup.bash ]]; then source catkin_ws/devel/setup.bash; fi; python3 scripts/prepare_workspace.py; catkin_make -C catkin_ws --build /slicer/catkin_ws/build_navigation -DCATKIN_DEVEL_PREFIX=/slicer/catkin_ws/devel_navigation -DCATKIN_WHITELIST_PACKAGES="livox_ros_driver2;fast_lio;slicer_navigation;slicer_bringup;slicer_wasd_control" -DROS_EDITION=ROS1 -DCMAKE_BUILD_TYPE=Release -j2 -l2'
fi
[[ -f "$ROOT/catkin_ws/devel_navigation/setup.bash" ]] || { echo 'First run: run_navigation.sh build'; exit 1; }
case "$MODE" in
  wasd)
    for candidate in slicer-mapping slicer-navigation; do
      if docker ps --format '{{.Names}}' | grep -qx "$candidate"; then
        exec docker exec -it "$candidate" bash -c \
          'source /opt/ros/noetic/setup.bash; source /slicer/catkin_ws/devel_navigation/setup.bash; exec rosrun slicer_wasd_control wasd_teleop_node.py --ros --config /slicer/catkin_ws/src/Slicer_wasd_control/config/teleop_params.yaml'
      fi
    done
    echo 'Start mapping/nav with start_control:=true first; WASD reuses that running container.'; exit 1 ;;
  mapping)
    NAME=slicer-mapping
    CMD=(roslaunch slicer_navigation mapping.launch root:=/slicer "$@") ;;
  nav)
    NAME=slicer-navigation
    MAP="${1:-}"
    if [[ -n "$MAP" && "$MAP" != *:=* ]]; then shift; else
      MAP="$(/usr/bin/python3 -s -c 'import sys,yaml;print(yaml.safe_load(open(sys.argv[1]))["navigation"]["map_file"] or "")' "$ROOT/config/slicer_config.yaml")"
    fi
    [[ -n "$MAP" ]] || { echo 'Usage: run_navigation.sh nav room.yaml [start_control:=true]'; exit 1; }
    if [[ "$MAP" != /* ]]; then
      if [[ -f "$PKG/maps/$MAP" ]]; then MAP="$PKG/maps/$MAP"; else MAP="$ROOT/$MAP"; fi
    fi
    MAP="$(realpath -e -- "$MAP")"
    [[ "$MAP" == "$ROOT/"* && "$MAP" == *.yaml ]] || { echo 'Map must be a YAML inside Slicer_Workspace'; exit 1; }
    CMD=(roslaunch slicer_navigation nav.launch root:=/slicer map_file:="/slicer/${MAP#"$ROOT/"}" "$@") ;;
  record)
    # Match the proven potato_rover_nav workflow: attach the recorder directly
    # to the running Noetic container, with live coordinates in this terminal.
    $BACKGROUND && { echo 'Recording needs a foreground terminal; omit --background.' >&2; exit 2; }
    RECORD_NAME="${1:-waypoints.yaml}"
    [[ "$RECORD_NAME" =~ ^[A-Za-z0-9_-]+\.yaml$ ]] || {
      echo 'Use a YAML filename in slicer_navigation/config, e.g. waypoints.yaml.' >&2; exit 2;
    }
    RECORD_FILE="/slicer/catkin_ws/src/slicer_navigation/config/$RECORD_NAME"
    TARGET=""
    for candidate in slicer-mapping slicer-navigation; do
      if docker ps --format '{{.Names}}' | grep -qx "$candidate"; then TARGET="$candidate"; break; fi
    done
    [[ -n "$TARGET" ]] || { echo 'Start mapping/nav first, then run record in another terminal.' >&2; exit 1; }
    for attempt in {1..30}; do
      if docker exec "$TARGET" bash -c 'source /opt/ros/noetic/setup.bash; rosparam get /rosdistro >/dev/null 2>&1'; then break; fi
      [[ "$attempt" != 30 ]] || { echo 'ROS master did not become ready.' >&2; exit 1; }
      sleep 1
    done
    if docker exec "$TARGET" bash -c 'source /opt/ros/noetic/setup.bash; rosnode list 2>/dev/null' |
        grep -qx /slicer_waypoint_recorder; then
      echo 'A waypoint recorder is already active; use its terminal to see coordinates.' >&2; exit 1
    fi
    TTY=(-i)
    [[ -t 0 && -t 1 ]] && TTY=(-it)
    echo "Select Publish Point in RViz; click a free map cell. Coordinates print here and save to $RECORD_FILE. Ctrl+C stops recording."
    exec docker exec "${TTY[@]}" --user "$(id -u):$(id -g)" -e HOME=/tmp/slicer-nav-home \
      -e SLICER_RECORD_FILE="$RECORD_FILE" \
      "$TARGET" bash -c \
      'source /opt/ros/noetic/setup.bash; source /slicer/catkin_ws/devel_navigation/setup.bash; exec rosrun slicer_navigation waypoint_recorder.py "_file:=$SLICER_RECORD_FILE"' ;;
  patrol)
    # A standalone patrol container would start its own ROS master when the
    # navigation container disappears, then wait on a stale action goal.
    # Run in the navigation container so losing move_base also stops patrol.
    $BACKGROUND && { echo 'Patrol must stay in a foreground terminal; omit --background.' >&2; exit 2; }
    docker ps --format '{{.Names}}' | grep -qx slicer-navigation || {
      echo 'Navigation is not running; start nav with start_control:=true first.' >&2; exit 1;
    }
    NODES="$(docker exec slicer-navigation bash -c \
      'source /opt/ros/noetic/setup.bash; rosnode list 2>/dev/null')" || {
      echo 'Navigation ROS master is unavailable; patrol not started.' >&2; exit 1;
    }
    for required in /move_base /slicer_c30d_driver /slicer_velocity_mux /slicer_nav_arc_guard; do
      printf '%s\n' "$NODES" | grep -qx "$required" || {
        echo "Required navigation/control node $required is absent; patrol not started." >&2; exit 1;
      }
    done
    TTY=(-i)
    [[ -t 0 && -t 1 ]] && TTY=(-it)
    exec docker exec "${TTY[@]}" --user "$(id -u):$(id -g)" -e HOME=/tmp/slicer-nav-home \
      slicer-navigation bash -c \
      'source /opt/ros/noetic/setup.bash; source /slicer/catkin_ws/devel_navigation/setup.bash; exec roslaunch slicer_navigation patrol.launch "$@"' bash "$@" ;;
  save-map) NAME="slicer-map-save-$$"; CMD=(bash /slicer/catkin_ws/src/slicer_navigation/scripts/save_map.sh "$@") ;;
  rviz) NAME=slicer-nav-rviz; CMD=(roslaunch slicer_navigation rviz.launch "$@") ;;
  check)
    NAME="slicer-nav-check-$$"
    CMD=(python3 /slicer/catkin_ws/src/slicer_navigation/tests/check_navigation.py) ;;
  *) echo 'Usage: run_navigation.sh {build|check|mapping|nav MAP.yaml|wasd|rviz|record|patrol|save-map [NAME]|stop} [--background] [launch arguments]'; exit 0 ;;
esac
if [[ "$MODE" == mapping || "$MODE" == nav ]]; then
  # Keep field warnings after --rm removes the stopped container. Logging only;
  # this does not respawn navigation, retry goals or change controller behavior.
  mkdir -p "$ROOT/logs/navigation/ros"
  ARGS+=(-v "$ROOT/logs/navigation/ros:/tmp/slicer-nav-log")
  # Jetson 无有效 RTC 时，开机早期可能仍为1970年；避免启动后跳时几十年破坏 TF/EKF。
  for attempt in {1..30}; do
    [[ "$(date +%s)" -lt 1704067200 ]] || break
    [[ "$attempt" != 1 ]] || echo 'Waiting for a valid system clock before starting ROS...'
    sleep 1
  done
  [[ "$(date +%s)" -ge 1704067200 ]] || { echo 'System clock is not ready; sync/set the date, then retry.'; exit 1; }
  # timesyncd 会从磁盘恢复一个看似有效但仍落后的日期；只检查年份不能防止首次 NTP 跳时。
  if command -v timedatectl >/dev/null && [[ "${SLICER_ALLOW_UNSYNCED_CLOCK:-0}" != 1 ]] && \
     [[ "$(timedatectl show -p NTP --value 2>/dev/null || true)" == yes ]]; then
    for attempt in {1..120}; do
      [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" != yes ]] || break
      [[ "$attempt" != 1 ]] || echo 'Waiting for initial NTP synchronization to prevent ROS/LiDAR clock jumps...'
      sleep 1
    done
    [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == yes ]] || {
      echo 'NTP has not synchronized. Check the network/time server, then retry.'
      echo 'Offline only: set a correct stable clock, disable automatic clock stepping, then use SLICER_ALLOW_UNSYNCED_CLOCK=1.'
      exit 1
    }
  fi
  for old in slicer-mapping slicer-navigation slicer-nav; do
    if docker ps --format '{{.Names}}' | grep -qx "$old"; then
      echo "Navigation/mapping container already running: $old"; exit 1
    fi
  done
  if [[ " $* " != *" start_sensors:=false "* ]]; then
    ARGS+=(-e SLICER_REQUIRE_SENSORS=1)
    read -r LIDAR_IF LIDAR_IP < <(/usr/bin/python3 -s -c 'import sys,yaml;s=yaml.safe_load(open(sys.argv[1]))["sensors"];print(s["lidar_interface"],s["host_lidar_ip"])' "$ROOT/config/slicer_config.yaml")
    if ! ip -4 -o addr show dev "$LIDAR_IF" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -Fxq "$LIDAR_IP"; then
      echo "LiDAR Ethernet is not ready: $LIDAR_IF needs host IP $LIDAR_IP."
      echo 'Connect/configure the LiDAR Ethernet NIC, or use start_sensors:=false to reuse a running sensor stack.'
      exit 1
    fi
  fi
fi
if [[ "$MODE" == rviz || " $* " == *" gui:=true "* || " $* " == *" rviz:=true "* || " $* " == *" wasd:=true "* ]]; then
  AUTH="/run/user/$(id -u)/gdm/Xauthority"
  [[ -r "$AUTH" ]] || AUTH="${XAUTHORITY:-$HOME/.Xauthority}"
  [[ -r "$AUTH" ]] || { echo 'Jetson local desktop Xauthority is not readable'; exit 1; }
  # The dummy display advertises 4K at only 17 Hz.  The old, proven rover
  # launcher switched to 1080p before starting RViz to reduce rendering and
  # RustDesk encoding load.  Keep that behavior for Slicer as well.
  if command -v xrandr >/dev/null 2>&1; then
    RVIZ_OUTPUT="$(DISPLAY=:0 XAUTHORITY="$AUTH" xrandr --query 2>/dev/null |
      awk '/ connected primary/{print $1; primary=1; exit} / connected/{if (!fallback) fallback=$1} END{if (!primary && fallback) print fallback}')"
    if [[ -n "$RVIZ_OUTPUT" ]]; then
      DISPLAY=:0 XAUTHORITY="$AUTH" xrandr --output "$RVIZ_OUTPUT" --mode 1920x1080 --rate 60 >/dev/null 2>&1 ||
        echo "WARNING: could not set $RVIZ_OUTPUT to 1920x1080@60; retaining current mode." >&2
    fi
  fi
  ARGS+=(-e DISPLAY=:0 -e XAUTHORITY=/tmp/slicer.xauth -e QT_X11_NO_MITSHM=1
    -v /tmp/.X11-unix:/tmp/.X11-unix -v "$AUTH:/tmp/slicer.xauth:ro")
  [[ ! -d /usr/share/fonts ]] || ARGS+=(-v /usr/share/fonts:/opt/host-fonts:ro)
fi
if [[ " $* " == *" start_control:=true "* ]]; then
  PORT="$(/usr/bin/python3 -s -c 'import sys;sys.path.insert(0,sys.argv[1]);from serial_transport import identity;from control_core import load_config;import glob;c=load_config();paths=sum((glob.glob(p) for p in ("/dev/ttyCH*","/dev/ttyACM*","/dev/ttyUSB*")),[]);v=[p for p in paths if identity(p)==("1a86","55d4",c["serial_number"])];print(v[0] if len(v)==1 else "")' "$ROOT/catkin_ws/src/Slicer_wasd_control/scripts")"
  [[ -c "$PORT" ]] || { echo 'Unique C30D device not found'; exit 1; }
  ARGS+=(--device="$PORT" --group-add "$(stat -c %g "$PORT")" -v /run/udev:/run/udev:ro)
fi
if [[ "$MODE" == mapping || "$MODE" == nav || "$MODE" == check ]]; then
  # Refresh generated ROS parameters from the current slicer_config.yaml before
  # launching. Otherwise editing max_forward only changes the source YAML while
  # move_base silently keeps the old .generated/navigation.yaml value.
  docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp \
    -v "$ROOT:/slicer" -w /slicer "$IMAGE" bash -c \
    'set -e; source /opt/ros/noetic/setup.bash; python3 scripts/prepare_workspace.py'
fi
if $BACKGROUND; then
  ARGS+=(-d)
fi
exec docker run "${ARGS[@]}" --name "$NAME" "$IMAGE" bash -c \
  'set -e; mkdir -p "$HOME" "$ROS_HOME" "$ROS_LOG_DIR"; source /opt/ros/noetic/setup.bash; source /slicer/catkin_ws/devel_navigation/setup.bash; if [[ "${SLICER_REQUIRE_SENSORS:-0}" == 1 ]]; then python3 /slicer/catkin_ws/src/slicer_navigation/scripts/runtime_preflight.py; fi; exec "$@"' bash "${CMD[@]}"
