Panels:
  - {Class: rviz/Displays, Name: Displays}
  - {Class: rviz/Tool Properties, Name: Tool Properties}
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 15
  Displays:
    - {Class: rviz/Grid, Name: Grid, Enabled: true, Plane Cell Count: 20}
    - {Class: rviz/Map, Name: Map, Enabled: true, Topic: /map, Color Scheme: map, Alpha: 1}
    - {Class: rviz/Axes, Name: Map Origin Axes, Enabled: true, Reference Frame: map, Length: 0.4, Radius: 0.012}
    - {Class: rviz/MarkerArray, Name: Robot and Map Origin, Enabled: true, Marker Topic: /slicer/navigation_markers, Queue Size: 1}
    - Class: rviz/LaserScan
      Name: Scan Points
      Enabled: true
      Topic: /scan
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Queue Size: 1
      Decay Time: 0
  Tools:
    - {Class: rviz/Interact}
    - {Class: rviz/MoveCamera}
    - {Class: rviz/SetInitialPose, Topic: /initialpose}
    - {Class: slicer_navigation/RecordWaypoint}
  Views:
    Current: {Class: rviz/TopDownOrtho, Scale: 70}
Window Geometry: {Width: 1100, Height: 720}
