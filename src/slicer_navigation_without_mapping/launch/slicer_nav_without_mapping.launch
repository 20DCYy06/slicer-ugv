<launch>
  <arg name="workspace2_root" default="$(eval optenv('WORKSPACE2_ROOT', find('slicer_navigation_without_mapping') + '/../..'))" />
  <arg name="runtime_root" default="$(eval optenv('SLICER_NO_RTK_RUNTIME', arg('workspace2_root') + '/runtime/no_rtk'))" />
  <arg name="host_config" default="$(arg runtime_root)/config/c30d_host.yaml" />
  <arg name="start_sensors" default="true" />
  <arg name="start_control" default="true" />
  <arg name="control_mock" default="false" />
  <arg name="gui" default="true" />
  <arg name="waypoint_file" default="$(arg workspace2_root)/src/slicer_navigation_without_mapping/config/waypoints.yaml" />
  <include if="$(arg start_sensors)" file="$(find slicer_bringup)/launch/sensors.launch">
    <arg name="root" value="$(arg runtime_root)" />
    <arg name="rviz" value="false" />
  </include>
  <include if="$(arg start_control)" file="$(find slicer_wasd_control)/launch/slicer_wasd_teleop.launch">
    <arg name="keyboard" value="false" />
    <arg name="publish_tf" value="false" />
    <arg name="mock" value="$(arg control_mock)" />
    <arg name="wait_for_fault_clear" value="true" />
    <arg name="workspace2_root" value="$(arg workspace2_root)" />
    <arg name="host_config" value="$(arg host_config)" />
    <arg name="config" value="$(arg runtime_root)/config/control.yaml" />
  </include>
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen" respawn="true">
    <rosparam command="load" file="$(arg runtime_root)/.generated/slam.yaml" />
    <remap from="scan" to="/scan" />
  </node>
  <node pkg="move_base" type="move_base" name="move_base" output="screen" required="true">
    <rosparam command="load" file="$(arg runtime_root)/.generated/vehicle.yaml" />
    <rosparam command="load" file="$(find slicer_navigation)/config/navigation_params.yaml" />
    <rosparam command="load" file="$(find slicer_navigation)/config/teb_local_planner_params.yaml" />
    <rosparam command="load" file="$(find slicer_navigation_without_mapping)/config/costmap_params.yaml" />
    <rosparam command="load" file="$(find slicer_navigation_without_mapping)/config/nav_params.yaml" />
    <remap from="cmd_vel" to="/cmd_vel/nav_raw" />
  </node>
  <node pkg="slicer_navigation" type="arc_velocity_guard.py" name="slicer_nav_arc_guard" output="screen" required="true">
    <param name="config_file" value="$(arg runtime_root)/config/slicer_config.yaml" />
    <param name="control_config_file" value="$(arg runtime_root)/config/control.yaml" />
    <rosparam command="load" file="$(find slicer_navigation)/config/arc_guard.yaml" />
  </node>
  <include if="$(arg gui)" file="$(dirname)/local_desktop.launch">
    <arg name="waypoint_file" value="$(arg waypoint_file)" />
  </include>
</launch>
