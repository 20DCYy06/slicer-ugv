Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 10
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz/Map
      Name: Occupancy Map
      Enabled: true
      Topic: /map
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: false
    - Class: rviz/Axes
      Name: Map Origin
      Enabled: true
      Reference Frame: map
      Length: 0.4
      Radius: 0.012
    - Class: rviz/MarkerArray
      Name: Robot and Map Origin
      Enabled: true
      Marker Topic: /slicer/navigation_markers
      Queue Size: 1
    - Class: rviz/LaserScan
      Name: Filtered Scan
      Enabled: true
      Topic: /scan
      Queue Size: 1
      Size (m): 0.025
      Style: Points
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz/TF
      Name: TF (optional)
      Enabled: false
      Frame Timeout: 5
      Show Axes: true
      Show Arrows: false
      Show Names: true
    - Class: rviz/PointCloud2
      Name: Body Cloud Debug
      Enabled: false
      Topic: /cloud_registered_body
      Queue Size: 1
      Style: Points
      Size (Pixels): 1
      Decay Time: 0
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Angle: 0
      Scale: 30
      X: 0
      Y: 0
Window Geometry:
  Width: 1280
  Height: 800
